# Copy to .env and put your key there:   cp .env.example .env
# .env is git-ignored: never commit it. Variables already set in the shell take precedence.

# --- Google Gemini (OpenAI-compatible endpoint) ---
HARNESS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Free tier (Sept 2026): flash-lite ~15 RPM / 500 RPD; gemini-3.5-flash and 3.8-flash only ~5 RPM / 20 RPD.
HARNESS_MODEL=gemini-3.5-flash-lite
HARNESS_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# --- OpenAI instead (comment out the three lines above, uncomment these) ---
# HARNESS_BASE_URL=https://api.openai.com/v1
# HARNESS_MODEL=
# HARNESS_API_KEY=

# Fixed decoding settings for the whole run.
HARNESS_TEMPERATURE=0
# Gemini thinking models may spend output tokens on hidden reasoning; 1024 can truncate the code.
HARNESS_MAX_TOKENS=4096
# Some newer/reasoning OpenAI models need: HARNESS_MAX_TOKENS_PARAM=max_completion_tokens and HARNESS_TEMPERATURE=none
HARNESS_MAX_TOKENS_PARAM=max_tokens
HARNESS_REQUEST_TIMEOUT=90
